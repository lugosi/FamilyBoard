# Public URL where you open the app (no trailing slash). Required behind HTTPS or non-localhost.
# Must match an authorized redirect URI in Google Cloud: ${PUBLIC_APP_URL}/api/auth/google/callback
PUBLIC_APP_URL=http://localhost:3000

# OAuth client from Google Cloud Console (Web application). One client is used for Calendar + Nest.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Nest Device Access *enterprise* UUID (Device Access console → Project → ID). Not the OAuth client id.
# Nest setup usually forces a *new* OAuth client because Device Access must be tied to a GCP project:
#   1. Create/link a Google Cloud project in https://console.nest.google.com/device-access
#   2. Enable "Smart Device Management API" on that same GCP project
#   3. Create the OAuth client (ID + secret) in that project's Credentials — not an older Calendar-only project
#   4. Put the enterprise UUID here; put that client's ID/secret in GOOGLE_CLIENT_ID / GOOGLE_CLIENT_SECRET above
# After switching clients, disconnect Google in the app and Link Google again (refresh token is per client).
# In Device Access → your project → Project Information: OAuth Client ID must match GOOGLE_CLIENT_ID exactly.
GOOGLE_NEST_PROJECT_ID=
# After Link Google, authorize home/devices once: /api/auth/nest/pcm
# Add BOTH redirect URIs on the OAuth Web client:
#   ${PUBLIC_APP_URL}/api/auth/google/callback
#   ${PUBLIC_APP_URL}/api/auth/nest/pcm/callback
# Optional PCM redirect override: NEST_PCM_REDIRECT_URI=https://www.google.com

# Spotify OAuth app credentials
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Strava OAuth (per family member — each person links their own account)
# Create an API app at https://www.strava.com/settings/api
# "Bad Request" / invalid redirect_uri almost always means the callback domain is wrong:
#   Authorization Callback Domain = hostname only of PUBLIC_APP_URL (e.g. board.example.com)
#   — no https://, no path, no port (except localhost / 127.0.0.1 which Strava whitelists)
# Redirect FamilyBoard sends: ${PUBLIC_APP_URL}/api/auth/strava/callback
# STRAVA_CLIENT_ID=
# STRAVA_CLIENT_SECRET=

# Optional: calendar to read/write. The AI assistant and inbox scan add events here; when unset they
# use a writable calendar named "berkeley" (same default as the board), else primary.
# GOOGLE_CALENDAR_ID=primary

# IANA timezone for new/edited events (default: America/Los_Angeles / Pacific)
DEFAULT_TIMEZONE=America/Los_Angeles

# Open-Meteo (no API key)
WEATHER_LAT=37.77
WEATHER_LON=-122.42
# WEATHER_TIMEZONE=auto

# Catlink litter box (optional)
# The CatLink app supports SMS login, but FamilyBoard uses CatLink's password API.
# Set a login password in the CatLink app first, then link once from the board UI.
# CATLINK_PHONE=
# CATLINK_PASSWORD=
# US accounts: international code 1 and USA API server (default below)
CATLINK_PHONE_IAC=1
CATLINK_API_BASE=https://app-usa.catlinks.cn/api/
# CATLINK_DEVICE_ID=   # optional if you have multiple devices
# CATLINK_LANGUAGE=en_US

# Hue bridge on your LAN
HUE_BRIDGE_IP=192.168.1.50
# Optional if you pair via the UI (stored under DATA_DIR/hue.json)
# HUE_USERNAME=

# Writable directory inside the container (mount a dataset here on TrueNAS)
DATA_DIR=/data

# Optional container listen port (for TrueNAS app edit). Keep in sync with your mapped container port.
APP_PORT=3000

# Optional internet-facing access gate (recommended when exposing the app publicly).
# BOARD_ACCESS_CODE: shared secret users type in /unlock (use a long random passphrase).
# BOARD_ACCESS_SECRET: server secret; rotating it clears all unlock sessions (DATA_DIR/gate-sessions.json).
# If either is missing, the gate is disabled.
# BOARD_ACCESS_CODE=
# BOARD_ACCESS_SECRET=

# WikiLLM (AI tab): Gemini + private GitHub markdown wiki
# Create an API key in Google AI Studio (same Google account family).
GEMINI_API_KEY=
# Free-tier default is gemini-3.5-flash-lite. For more capability (still free tier): gemini-3.6-flash
# GEMINI_MODEL=gemini-3.5-flash-lite
# Live web lookup: tries Gemini Google Search grounding, then free DuckDuckGo (+ ESPN scores) fallback.
# Optional override if your key still has a Search-capable model:
# GEMINI_SEARCH_MODEL=gemini-3.5-flash-lite
# Private family wiki — only the token is required (repo defaults to lugosi/family-wiki).
# Fine-grained PAT with Contents read/write on that repo.
# WIKILM_GITHUB_TOKEN=
# WIKILM_GITHUB_REPO=lugosi/family-wiki
# WIKILM_GITHUB_BRANCH=   # optional; defaults to the repo's default branch
# WIKILM_GITHUB_PATH=wiki
# Layout, page template, and how the assistant edits pages: docs/WIKI.md
# Local mocks only: WIKILM_GITHUB_API_BASE_URL=http://127.0.0.1:4010/github
# Optional: Gemini-compatible gateway/proxy (default https://generativelanguage.googleapis.com)
# GEMINI_API_BASE_URL=
# After deploying Gmail scopes: enable Gmail API in GCP, then disconnect + Link Google again.
# Forward actionable mail to that inbox; AI tab → Scan inbox → todos (DATA_DIR/todos.json)
# and calendar events (GOOGLE_CALENDAR_ID). Optional background scan interval in minutes (0 = off):
# GMAIL_AUTO_SCAN_MINUTES=15

# Slack bot (optional): DM the bot or @mention it in a channel to use the assistant from your phone.
# Socket Mode (outbound only, no public URL). Create the app from the manifest in docs/SLACK_SETUP.md.
# SLACK_BOT_TOKEN=xoxb-...
# App-level token with connections:write
# SLACK_APP_TOKEN=xapp-...

